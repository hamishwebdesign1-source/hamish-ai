# --- Email (Resend) ---
# While using Resend's shared onboarding@resend.dev sender (no domain verified yet),
# CONTACT_TO_EMAIL must exactly match the address on your Resend account, including case.
# Once hamishai.org is verified in Resend, sendClientEmail/sendErrorAlert send from
# real @hamishai.org addresses instead — see src/lib/send-client-email.ts.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hamishwebdesign1@gmail.com

# --- AI chatbot + copilots (get a key at console.anthropic.com) ---
# Without this, the marketing chat widget runs in scripted "demo mode"
# instead of calling real Claude; the portal Ask/Copilot features and
# request triage return an explicit "not configured" error instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Supabase (get these from your Supabase project settings) ---
# SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY: the service-role client
# (getSupabaseAdmin()) used by every admin/cron/webhook write path —
# bypasses Row Level Security by design, so treat the service-role key
# like a master password, never expose it client-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL/NEXT_PUBLIC_SUPABASE_ANON_KEY: the session-scoped
# client (createServerSupabaseClient()) the client portal's read paths use —
# carries the signed-in user's own JWT, so Postgres RLS (see supabase/schema-*.sql)
# enforces tenant isolation independently of application code. Safe to expose
# client-side; these are meant to be public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Internal /admin tool ---
# ADMIN_PASSWORD: the one shared password gating /admin (single-operator
# model, no per-admin identity yet — see the standing note on a
# second-operator access model).
# ADMIN_EMAIL: the one address allowed to use the magic-link login instead
# of typing the password (src/app/api/internal/admin-callback/route.ts).
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- Cron authentication ---
# A shared secret Vercel Cron sends as `Authorization: Bearer <value>` —
# every route under /api/cron/* checks it before doing anything, so an
# arbitrary POST to a cron URL can't trigger a real run. Vercel sets this
# automatically for Vercel Cron jobs (see vercel.json); set it manually if
# you ever trigger a cron route from elsewhere.
CRON_SECRET=

# --- Stripe billing (see supabase/schema-billing.sql, schema-subscriptions.sql) ---
# STRIPE_SECRET_KEY: used for one-off invoices (create-invoice.ts), real
# per-client subscriptions (subscription.ts), and the Customer Portal
# (stripe-portal-session route). STRIPE_WEBHOOK_SECRET verifies that
# incoming events at /api/webhooks/stripe genuinely came from Stripe —
# get it from the Dashboard's webhook endpoint settings, not the API keys page.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google Workspace integration (email inbox + calendar sync) ---
# OAuth credentials from Google Cloud Console, plus a refresh token
# obtained once via the local setup script (see /admin/google-setup for
# the walkthrough). Optional — without these, email-inbox and
# calendar-sync crons simply skip their run.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Microsoft Graph integration (Teams meeting scheduling — see
# docs/teams-meeting-intelligence-plan.md) ---
# From an Azure AD app registration. Unlike Google, there's no
# MS_REFRESH_TOKEN var here — Microsoft's token endpoint rotates the
# refresh token on every use, so it's stored in the ms_graph_tokens table
# instead (see src/lib/ms-graph-auth.ts) and kept up to date automatically
# once you connect once via /admin/ms-setup. Optional — without these,
# "Schedule Teams meeting" on /admin/leads simply errors out.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

# --- Misc ---
# Calendly scheduling link embedded on /book. Optional — the page shows a
# plain "get in touch" fallback if unset.
CALENDLY_URL=

# --- ViewMax video generation (Content Factory — see
# docs/content-factory-plan.md) ---
# Get an API key at viewmax.studio once you've signed up (Settings > API
# keys). Optional — without it, the content-video-pipeline cron logs
# "not configured" and skips submission every run; idea discovery,
# research, and script generation all work fully without it.
VIEWMAX_API_KEY=
# Credit buffer below which video submission pauses for the run and folds
# a note into the next review-alert email instead of failing per-idea.
# Optional, defaults to 5 in code if unset.
VIEWMAX_MIN_CREDIT_BUFFER=
